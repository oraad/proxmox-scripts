#!/usr/bin/env bash
# Copyright (c) 2026 Proxmox Custom Scripts contributors
# License: MIT
#
# Thin wrapper around community-scripts build.func that redirects install scripts
# and ASCII headers to this repository.

REPO_RAW="${REPO_RAW:-https://raw.githubusercontent.com/oraad/proxmox-scripts/main}"
CS_RAW="${CS_RAW:-https://raw.githubusercontent.com/community-scripts/ProxmoxVE/main}"

_build_func_content="$(curl -fsSL "${CS_RAW}/misc/build.func")"
_build_func_content="${_build_func_content//https:\/\/raw.githubusercontent.com\/community-scripts\/ProxmoxVE\/main\/install/${REPO_RAW}\/install}"
_build_func_content="${_build_func_content//create_lxc_container || exit \$?/create_lxc_container || exit \$?
  apply_extra_nics || true
  apply_app_bind_mounts || true}"

source /dev/stdin <<<"$_build_func_content"
unset _build_func_content

# Extra LXC NICs (net1–net9) after the upstream wizard's single net0.
# Interactive Advanced installs only; Default / unattended leave net0 as-is.
apply_extra_nics() {
  [[ -z "${CTID:-}" ]] && return 0
  command -v pct >/dev/null 2>&1 || return 0
  command -v whiptail >/dev/null 2>&1 || return 0

  if declare -f is_unattended >/dev/null 2>&1 && is_unattended; then
    return 0
  fi
  [[ "${PHS_SILENT:-0}" == "1" ]] && return 0
  [[ "${var_unattended:-}" =~ ^(yes|true|1)$ ]] && return 0
  [[ "${UNATTENDED:-}" =~ ^(yes|true|1)$ ]] && return 0
  [[ ! -t 0 ]] && return 0

  local method="${METHOD:-${MODE:-${mode:-}}}"
  method="${method,,}"
  case "$method" in
    advanced | 2) ;;
    *) return 0 ;;
  esac

  _extra_nic_next_index() {
    local idx=1
    while [[ "$idx" -le 9 ]]; do
      if ! pct config "$CTID" 2>/dev/null | grep -q "^net${idx}:"; then
        echo "$idx"
        return 0
      fi
      idx=$((idx + 1))
    done
    return 1
  }

  _extra_nic_bridge_menu() {
    local -a menu=()
    local iface seen=" "
    _extra_nic_add_bridge() {
      local name="$1" desc="$2"
      [[ -z "$name" || "$seen" == *" ${name} "* ]] && return 0
      seen+="${name} "
      menu+=("$name" "$desc")
    }
    while IFS= read -r iface; do
      _extra_nic_add_bridge "$iface" "Linux bridge"
    done < <(ip -br link show type bridge 2>/dev/null | awk '{print $1}' | sort -u)

    if command -v ovs-vsctl >/dev/null 2>&1; then
      while IFS= read -r iface; do
        _extra_nic_add_bridge "$iface" "OVS bridge"
      done < <(ovs-vsctl list-br 2>/dev/null | sort -u)
    fi

    if [[ -f /etc/pve/sdn/vnets.cfg ]]; then
      while IFS= read -r iface; do
        _extra_nic_add_bridge "$iface" "SDN vnet"
      done < <(awk '/^vnet:/{print $2}' /etc/pve/sdn/vnets.cfg 2>/dev/null)
    fi

    if [[ ${#menu[@]} -eq 0 ]]; then
      echo "vmbr0"
      return 0
    fi

    local chosen
    if chosen=$(whiptail --backtitle "Proxmox Custom Scripts" \
      --title "ADDITIONAL NETWORK BRIDGE" \
      --ok-button "Next" --cancel-button "Skip" \
      --menu "\nSelect the bridge or SDN vnet for this adapter:" 16 58 6 \
      "${menu[@]}" \
      3>&1 1>&2 2>&3); then
      echo "$chosen"
      return 0
    fi
    return 1
  }

  command -v stop_spinner >/dev/null 2>&1 && stop_spinner

  while true; do
    local idx
    idx="$(_extra_nic_next_index)" || {
      msg_warn "Maximum of 10 LXC NICs (net0–net9) already in use"
      return 0
    }

    if ! whiptail --backtitle "Proxmox Custom Scripts" \
      --title "ADDITIONAL NETWORK ADAPTER" \
      --yes-button "Add adapter" --no-button "Continue" --defaultno \
      --yesno "Add another network adapter (net${idx})?\n\nnet0 is already configured. Extra adapters are optional (IoT VLAN, management, etc.)." 12 70; then
      return 0
    fi

    local default_name="eth${idx}" ifname name_input
    while true; do
      if ! name_input=$(whiptail --backtitle "Proxmox Custom Scripts" \
        --title "ADAPTER NAME FOR net${idx}" \
        --ok-button "Next" --cancel-button "Skip" \
        --inputbox "\nInterface name inside the container.\nLeave blank for default: ${default_name}" 12 58 "$default_name" \
        3>&1 1>&2 2>&3); then
        continue 2
      fi
      name_input="${name_input%"${name_input##*[![:space:]]}"}"
      name_input="${name_input#"${name_input%%[![:space:]]*}"}"
      ifname="${name_input:-$default_name}"
      if [[ ! "$ifname" =~ ^[a-zA-Z][a-zA-Z0-9._-]{0,14}$ ]]; then
        whiptail --msgbox "Invalid adapter name.\nUse 1–15 characters starting with a letter (e.g. eth1, mesh0)." 10 58
        continue
      fi
      if pct config "$CTID" 2>/dev/null | grep -E "^net[0-9]+:" | grep -qE "(^|,)name=${ifname}(,|$)"; then
        whiptail --msgbox "Adapter '${ifname}' is already used on this container." 8 58
        continue
      fi
      break
    done

    local bridge
    bridge="$(_extra_nic_bridge_menu)" || continue
    if declare -f validate_bridge >/dev/null 2>&1; then
      if ! validate_bridge "$bridge" && ! { declare -f validate_sdn_vnet >/dev/null 2>&1 && validate_sdn_vnet "$bridge"; }; then
        whiptail --msgbox "Bridge or vnet '${bridge}' is not available." 8 58
        continue
      fi
    fi

    local ip_mode
    ip_mode=$(whiptail --backtitle "Proxmox Custom Scripts" \
      --title "IPv4 FOR ${ifname}" \
      --ok-button "Next" --cancel-button "Skip" \
      --menu "\nSelect IPv4 assignment for ${ifname}:" 14 58 2 \
      "dhcp" "Automatic (DHCP)" \
      "static" "Static CIDR (gateway optional)" \
      3>&1 1>&2 2>&3) || continue

    local ip="dhcp"
    local gw=""
    if [[ "$ip_mode" == "static" ]]; then
      local cidr
      cidr=$(whiptail --backtitle "Proxmox Custom Scripts" \
        --title "STATIC IPv4 FOR ${ifname}" \
        --ok-button "Next" --cancel-button "Skip" \
        --inputbox "\nEnter IPv4 CIDR (e.g. 192.168.10.50/24)" 10 58 "" \
        3>&1 1>&2 2>&3) || continue
      if declare -f validate_ip_address >/dev/null 2>&1 && ! validate_ip_address "$cidr"; then
        whiptail --msgbox "Invalid IPv4 CIDR.\nExample: 192.168.10.50/24" 8 58
        continue
      fi
      ip="$cidr"
      gw=$(whiptail --backtitle "Proxmox Custom Scripts" \
        --title "GATEWAY FOR ${ifname}" \
        --ok-button "Next" --cancel-button "Skip" \
        --inputbox "\nEnter gateway IPv4, or leave blank (typical for extra NICs)" 10 58 "" \
        3>&1 1>&2 2>&3) || continue
      if [[ -n "$gw" ]] && declare -f validate_gateway_ip >/dev/null 2>&1 && ! validate_gateway_ip "$gw"; then
        whiptail --msgbox "Invalid gateway IP.\nExample: 192.168.10.1" 8 58
        continue
      fi
    fi

    local vlan
    vlan=$(whiptail --backtitle "Proxmox Custom Scripts" \
      --title "VLAN TAG FOR ${ifname}" \
      --ok-button "Add" --cancel-button "Skip" \
      --inputbox "\nVLAN tag 1–4094, or leave blank for none" 10 58 "" \
      3>&1 1>&2 2>&3) || continue
    if declare -f validate_vlan_tag >/dev/null 2>&1 && ! validate_vlan_tag "$vlan"; then
      whiptail --msgbox "Invalid VLAN tag. Use 1–4094 or leave blank." 8 58
      continue
    fi

    local net_spec="name=${ifname},bridge=${bridge},ip=${ip}"
    [[ -n "$gw" ]] && net_spec+=",gw=${gw}"
    [[ -n "$vlan" ]] && net_spec+=",tag=${vlan}"

    msg_info "Adding net${idx} (${net_spec})"
    if ! pct set "$CTID" -net"${idx}" "$net_spec" >>"${BUILD_LOG:-/dev/null}" 2>&1; then
      msg_warn "Failed to add net${idx} — add manually: pct set ${CTID} -net${idx} ${net_spec}"
      return 0
    fi
    msg_ok "Added net${idx} on ${bridge} (${ifname})"
  done
}

apply_app_bind_mounts() {
  [[ -z "${var_media_path:-}" ]] && return 0
  [[ -z "${CTID:-}" ]] && return 0
  if [[ ! -d "${var_media_path}" ]]; then
    msg_warn "var_media_path '${var_media_path}' not found on host — skipping bind mount"
    return 0
  fi

  msg_info "Binding ${var_media_path} → /media in CT ${CTID}"
  if ! pct set "$CTID" -mp0 "${var_media_path},mp=/media" >>"${BUILD_LOG:-/dev/null}" 2>&1; then
    msg_warn "Failed to bind mount — add manually: pct set ${CTID} -mp0 ${var_media_path},mp=/media"
    return 0
  fi

  pct reboot "$CTID" >>"${BUILD_LOG:-/dev/null}" 2>&1 || true
  local _
  for _ in $(seq 1 30); do
    pct exec "$CTID" -- true 2>/dev/null && break
    sleep 2
  done
  msg_ok "Bound music library at /media"
}

apply_debian13_lxc_defaults() {
  [[ "${var_os:-debian}" == "debian" ]] || return 0
  [[ "${var_version:-13}" == "13" ]] || return 0
  var_nesting="${var_nesting:-1}"
  var_keyctl="${var_keyctl:-1}"
}

apply_alpine_lxc_defaults() {
  [[ "${var_os:-debian}" == "alpine" ]] || return 0
  var_nesting="${var_nesting:-1}"
  var_keyctl="${var_keyctl:-1}"
}

# Override header fetch so custom ct/headers/* files load from this repo.
get_header() {
  local app_name
  if [[ -n "${NSAPP:-}" ]]; then
    app_name="${NSAPP,,}"
  else
    app_name="${1,,}"
    app_name="${app_name// /}"
  fi
  local header_dir="ct"
  local header_url="${REPO_RAW}/${header_dir}/headers/${app_name}"
  local local_header_path="/usr/local/community-scripts/headers/${header_dir}/${app_name}"

  mkdir -p "$(dirname "$local_header_path")"

  if [[ ! -s "$local_header_path" ]]; then
    if ! curl -fsSL "$header_url" -o "$local_header_path" 2>/dev/null; then
      command -v msg_warn >/dev/null 2>&1 && msg_warn "Failed to download header: $header_url"
      return 1
    fi
  fi

  cat "$local_header_path"
}
